{
  "name": "@salbot/bot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "apply:team-roles": "tsx scripts/apply-team-role-mappings.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "@salbot/db": "workspace:*",
    "@salbot/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
