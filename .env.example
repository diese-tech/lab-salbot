# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel IDs — right-click channel in Discord (Developer Mode) → Copy Channel ID
CHANNEL_ADMIN_REVIEW=
CHANNEL_RESULTS_SOLAR=
CHANNEL_RESULTS_LUNAR=
CHANNEL_RESULTS_TERRA=
CHANNEL_RESCHEDULES_SOLAR=
CHANNEL_RESCHEDULES_LUNAR=
CHANNEL_RESCHEDULES_TERRA=
# Comma-separated channel IDs where players may run /update-ign (e.g. ticket channels).
# Leave blank to restrict /update-ign to admins only.
DISCORD_ALIAS_CHANNEL_IDS=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sal-site standings recalculation (audit F-01). After a Discord-approved
# match result, the bot calls back into sal-site so standings recalculate the
# same way an admin save does. Set SAL_SITE_INTERNAL_TOKEN to the same value
# as sal-site's INTERNAL_SERVICE_TOKEN. If either is unset, the bot logs a
# warning and skips recalculation — an admin can still recalculate manually.
SAL_SITE_URL=
SAL_SITE_INTERNAL_TOKEN=

# OpenRouter (Captain Rules Assistant — /rules command)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Reserved task-specific vision model. Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_MODEL_VISION=

# ForgeLens
FORGELENS_API_URL=
FORGELENS_API_KEY=

# Web Panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
