# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs authorized for /report-result and /log-scouter.
SAL_OPERATOR_ROLE_IDS=
# Comma-separated Discord admin role IDs that override the operator allowlist.
SAL_ADMIN_ROLE_IDS=
# Optional narrower allowlist for the /report-result Enter stats button.
# Falls back to SAL_OPERATOR_ROLE_IDS when unset; admins always retain access.
SAL_MATCH_STATS_ROLE_IDS=
# Railway injects PORT; 3000 is the local default for /healthz.
PORT=3000

# Channel IDs — right-click channel in Discord (Developer Mode) → Copy Channel ID
CHANNEL_ADMIN_REVIEW=
CHANNEL_RESULTS_SOLAR=
CHANNEL_RESULTS_LUNAR=
CHANNEL_RESULTS_TERRA=
CHANNEL_RESCHEDULES_SOLAR=
CHANNEL_RESCHEDULES_LUNAR=
CHANNEL_RESCHEDULES_TERRA=
# Comma-separated channel IDs where players may run /update-ign (e.g. ticket channels).
# Leave blank to restrict /update-ign to admins only.
DISCORD_ALIAS_CHANNEL_IDS=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sal-site internal boundary for host match-stat links, scouter ingestion, and
# standings recalculation. SAL_SITE_INTERNAL_TOKEN must match sal-site's
# INTERNAL_SERVICE_TOKEN.
SAL_SITE_URL=
SAL_SITE_INTERNAL_TOKEN=

# OpenRouter (Captain Rules Assistant — /rules command)
OPENROUTER_API_KEY=
# Cheap/free text model for /rules. Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_MODEL_RULES=
# Legacy shared fallback for task-specific model variables.
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Reserved task-specific vision model. Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_MODEL_VISION=

# ForgeLens
FORGELENS_API_URL=
FORGELENS_API_KEY=

# Web Panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
