{
  "name": "salbot",
  "private": true,
  "workspaces": [
    "apps/bot",
    "packages/db",
    "packages/shared"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "pnpm --filter @salbot/db generate",
    "check:db-contract": "node scripts/db-contract.mjs check packages/db/src/types/database.types.ts",
    "sync:db-contract": "node scripts/db-contract.mjs sync packages/db/src/types/database.types.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "postcss@<8.5.23": "8.5.23",
      "undici@<6.28.0": "6.28.0",
      "ws@>=8.0.0 <8.21.0": "8.21.1"
    }
  }
}
