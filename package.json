{
  "name": "salbot",
  "private": true,
  "workspaces": [
    "apps/bot",
    "packages/db",
    "packages/shared"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "pnpm --filter @salbot/db generate",
    "check:db-contract": "node scripts/db-contract.mjs check packages/db/src/types/database.types.ts",
    "sync:db-contract": "node scripts/db-contract.mjs sync packages/db/src/types/database.types.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.1"
    }
  }
}
